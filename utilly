#!/bin/bash

help() {
    echo "UTilly, Tillytam's simple utility program."
    echo "Options - can be inputted after running command, or inline:"
    echo "cdnupload [FILE_PATH] - Upload a file to TillyTam CDN"
    echo "configbackup [FILE_PATH (optional)] - Copies various config files into specified folder"
}

echo "====================="
echo "= TILLYTAM'S UTILLY ="
echo "====================="

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
COMMAND=$1

if [[ -z $1 ]]; then
    help
    read -sp "Input option: " COMMAND
    echo
fi

if [[ $COMMAND = "cdnupload" ]]; then
    echo "Activating CDN Upload Module"
    bash $SCRIPT_DIR/src/cdnupload.sh "$2"
elif [[ $COMMAND = "configbackup" ]]; then
    echo "Copying Configuration Files"
    bash $SCRIPT_DIR/src/configbackup.sh "$2"
else
    echo "Unknown option"
fi